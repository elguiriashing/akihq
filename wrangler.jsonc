{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "akihq-management-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "AKIHQ_GATEWAY", "service": "akihq-integration-gateway" },
  ],
  "vars": {
    "NEXT_PUBLIC_PRODUCT_NAME": "AkiHQ",
    "NEXT_PUBLIC_SITE_URL": "https://akihq.app",
    "NEXT_PUBLIC_BUSINESS_URL": "https://akibusiness.com",
    "NEXT_PUBLIC_CRM_URL": "https://akihq.app",
    "NEXT_PUBLIC_AKISUITE_ROLE_SWAP": "true",
    "NEXT_PUBLIC_DATA_PROVIDER": "hybrid",
    "NEXT_PUBLIC_GOOGLE_AUTH_ENABLED": "true",
    "NEXT_PUBLIC_MAP_STYLE_URL": "https://tiles.openfreemap.org/styles/liberty",
    "AKISUITE_FUNNEL_READY": "true",
    "AKISUITE_CHECKOUT_ENABLED": "false",
    "AKISUITE_TAX_READY": "false",
    "AKISUITE_SUBSCRIPTIONS_READY": "false",
    "AKISUITE_FEATURES_READY": "false",
    "AKISUITE_LISTING_LIMITS_READY": "true",
    "AKISUITE_LISTING_UPLOADS_READY": "true",
    "AKISUITE_BILLING_VERIFIED": "false",
  },
  "limits": { "cpu_ms": 1000, "subrequests": 100 },
  "observability": { "enabled": true },
}
