# Enable only for an accepted coordinated domain cutover; rebuild both applications.
NEXT_PUBLIC_AKISUITE_ROLE_SWAP=false
# PUBLIC configuration. Obtain the existing shared project's URL/key securely.
NEXT_PUBLIC_PRODUCT_NAME=AkiBusiness
NEXT_PUBLIC_SITE_URL=https://akibusiness.com
NEXT_PUBLIC_BUSINESS_URL=https://akibusiness.com
NEXT_PUBLIC_CRM_URL=https://akihq.app
NEXT_PUBLIC_AKIHQ_URL=https://akihq.app
NEXT_PUBLIC_DATA_PROVIDER=hybrid
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
NEXT_PUBLIC_SUPABASE_URL=https://vhpbvcfkcteswlsdjrfl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Exact HTTPS preview origins (comma-separated); do not allow *.workers.dev.
AKISUITE_ALLOWED_PREVIEW_ORIGINS=
# Optional server-only translation and support integration. Supply via secrets.
AKIPASA_TRANSLATION_URL=
AKIPASA_TRANSLATION_API_KEY=
AI_CRM_PROXY_SECRET=
# Existing tenant-safe gateway binding: AKIHQ_GATEWAY.
# Do not enable billing while migration/provider acceptance remains pending.
AKISUITE_CHECKOUT_ENABLED=false
AKISUITE_TAX_READY=false
AKISUITE_SUBSCRIPTIONS_READY=false
AKISUITE_FEATURES_READY=false
AKISUITE_BILLING_VERIFIED=false
# No Stripe webhook, cron, renewal or outbox scheduler is owned by this Worker.
# Existing shared delivery paths may use RESEND_API_KEY and
# SUPABASE_SERVICE_ROLE_KEY server-side only, provisioned securely if approved.
# No secret values belong in this file or NEXT_PUBLIC_* variables.

# Enable only after reviewed additive private-location RPC is applied and verified.
AKISUITE_PRIVATE_LOCATIONS_READY=false

# Enable after independent property migration/API/RLS acceptance.
AKISUITE_ACCOMMODATION_READY=false

# Enable only after explicit company grouping migration and permission acceptance.
AKISUITE_ORGANISATIONS_READY=false

# Free AkiPulse overview and independently gated read-only booking aggregates.
AKIPULSE_ENABLED=false
AKIPULSE_SCOPED_BOOKINGS_READY=false
